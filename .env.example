# Root environment file. Used by docker compose, Vite frontend, and backend.
# Copy to .env for local work. Do not commit real .env files.

# App runtime
# APP_ENV: local | production | staging/custom. Non-local requires real auth secrets.
APP_ENV=local
# DEBUG: true | false. Use false outside local.
DEBUG=true
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
# VITE_LOG_LEVEL: debug | info | warn | error | silent.
VITE_LOG_LEVEL=warn
# PROJECT_NAME: human-readable FastAPI title.
PROJECT_NAME=VladBlog Collectibles API
# RESET_DATABASE_ON_START: true | false. true truncates dev data except production.
RESET_DATABASE_ON_START=false

# Database
# POSTGRES_USER: postgres username for local docker database.
POSTGRES_USER=postgres
# POSTGRES_PASSWORD: postgres password for local docker database.
POSTGRES_PASSWORD=postgres
# POSTGRES_DB: postgres database name for local docker database.
POSTGRES_DB=vladik_collectibles
# DATABASE_URL: backend URL for direct host runs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vladik_collectibles
# DOCKER_DATABASE_URL: backend URL inside docker compose network.
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vladik_collectibles

# Backend service binding
# BACKEND_HOST: 0.0.0.0 for docker/tunnels, 127.0.0.1 for local-only.
BACKEND_HOST=0.0.0.0
# BACKEND_PORT: any free TCP port, default 8000.
BACKEND_PORT=8000

# Frontend service binding
# FRONTEND_HOST: 0.0.0.0 for docker/tunnels, 127.0.0.1 for local-only.
FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT: any free TCP port, default 5173.
FRONTEND_PORT=5173

# Telegram
# TELEGRAM_BOT_TOKEN: your_bot_token placeholder in local, BotFather token outside local.
TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHANNEL_ID: @channel_username | numeric channel id | empty.
TELEGRAM_CHANNEL_ID=your_channel_id

# JWT/auth
# JWT_SECRET_KEY: local_dev_only_* in local, 32+ byte real secret outside local.
JWT_SECRET_KEY=local_dev_only_jwt_secret_change_me_32
# JWT_ALGORITHM: HS256.
JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: positive integer. 10080 = 7 days.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# DEV_AUTH_ENABLED: true | false. /auth/dev works only when APP_ENV=local.
DEV_AUTH_ENABLED=true

# CORS and public URLs
# BACKEND_CORS_ORIGINS: comma-separated URLs or JSON array.
BACKEND_CORS_ORIGINS=http://localhost:5173
# PUBLIC_FRONTEND_URL: local http URL or public HTTPS tunnel URL.
PUBLIC_FRONTEND_URL=http://localhost:5173
# PUBLIC_BACKEND_URL: local http URL or public HTTPS tunnel URL.
PUBLIC_BACKEND_URL=http://localhost:8000

# Media storage
# STORAGE_BACKEND: local. Other storage backends are not implemented yet.
STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH: root-level media folder for direct backend runs.
# Docker compose overrides this to /project_data/media inside the container.
LOCAL_STORAGE_PATH=./project_data/media
# PUBLIC_MEDIA_BASE_URL: empty derives to ${PUBLIC_BACKEND_URL}/media; otherwise absolute public URL.
PUBLIC_MEDIA_BASE_URL=

# Generation
# GENERATION_ENABLED: true | false. false is a hard kill switch.
GENERATION_ENABLED=true
# GENERATION_MODE: mock | openai | false. openai requires OPENAI_API_KEY.
GENERATION_MODE=mock
# GENERATION_BACKGROUND_TASKS: true | false. false runs generation inline.
GENERATION_BACKGROUND_TASKS=true
# GENERATION_AUDIT_LOG_PATH: root-level JSONL path; empty disables audit file writes.
# Docker compose overrides this to /project_data/logs/generation-audit.jsonl inside the container.
GENERATION_AUDIT_LOG_PATH=./project_data/logs/generation-audit.jsonl

# OpenAI image generation
# OPENAI_API_KEY: empty for mock mode, sk-proj... for openai mode.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL: model available to account, default gpt-image-2.
OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE: model-dependent size, default 1024x1024.
OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY: low | medium | high when supported by the model.
OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_MAX_ATTEMPTS: positive integer retry/attempt cap.
OPENAI_IMAGE_MAX_ATTEMPTS=2
