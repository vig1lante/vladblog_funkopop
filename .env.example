# App
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME=VladBlog Collectibles API
RESET_DATABASE_ON_START=false

# Database for docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vladik_collectibles
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vladik_collectibles

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=your_channel_id

# JWT
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173

# Media storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/media
PUBLIC_MEDIA_BASE_URL=
GENERATION_ENABLED=true
GENERATION_MODE=mock
GENERATION_BACKGROUND_TASKS=true
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MAX_ATTEMPTS=2

# Public URLs for local docs and Cloudflare Tunnel testing
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000
